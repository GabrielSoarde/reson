<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WinExe = no console window when launched from a shortcut.
         Logs still go to %LOCALAPPDATA%\Reson\logs\ via the rolling file
         provider. If you launch from a terminal for debugging, Console.WriteLine
         output is still attached to that terminal. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Soundpad</RootNamespace>
    <!-- User-facing rebrand: csproj filename + namespace stay "Soundpad" (internal),
         but the assembly/exe ships as Reson.exe and the EXE/window icons come from
         assets/Reson.ico. -->
    <AssemblyName>Reson</AssemblyName>
    <!-- Mirrors Soundpad.AppVersion.Current and installer MyAppVersion so the
         assembly version, the update check, and the release tag all agree. -->
    <Version>1.0.2</Version>
    <ApplicationIcon>..\..\assets\Reson.ico</ApplicationIcon>
    <!--
      WPF SDK auto-detects App.xaml/MainWindow.xaml and synthesizes an entry point.
      We use top-level statements in Program.cs as the entry point and build the
      WPF Application in code (Wpf/WpfHost.cs), so suppress those auto-includes.
    -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soundpad.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      UseWPF=true changes which namespaces the SDK injects as global usings;
      System.IO (present under Microsoft.NET.Sdk.Web alone) drops out. Re-add it
      explicitly so the existing IO-using files don't need per-file usings.
      Same for System.Net.Http which Sdk.Web normally provides.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Copy the sample sounds at the repo root to the runtime sounds/ folder
      next to the .exe on every build and publish. Without this, `dotnet run`
      and the published .exe see an empty sounds/ folder on first boot and
      the AutoScan finds nothing to register.
    -->
    <None Include="..\..\sounds\**\*.*" Link="sounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Embed the Reson icon as a WPF Resource so MainWindow / SettingsWindow
      and the tray icon can load it via pack URI
      ("pack://application:,,,/Reson.ico"). Resources are baked into the
      assembly's resource manifest, so this works under
      PublishSingleFile=true (the single-file bootstrap inlines the
      assembly) without shipping the .ico as a sibling file.
    -->
    <Resource Include="..\..\assets\Reson.ico" Link="Reson.ico" />
  </ItemGroup>
</Project>
